# Live Google Sheet. Share: Anyone with the link → Viewer.
GOOGLE_SHEET_URL=

# Coolify / Docker login. Both are required or the dashboard stays locked.
AUTH_EMAIL=
AUTH_PASSWORD=

# Optional. If empty, the session is signed from AUTH_EMAIL + AUTH_PASSWORD.
# Set a long random value in Coolify so sessions survive a password change.
AUTH_SECRET=

# Maytapi WhatsApp (from the Postman collection). Keep the token in Coolify / .env.local only.
MAYTAPI_PRODUCT_ID=
MAYTAPI_TOKEN=
MAYTAPI_PHONE_ID=
# Optional fallback recipients: 9715...:en:Karam,9715...:ar:Saddam
MAYTAPI_TO_NUMBERS=

# Daily WhatsApp at 06:15 Asia/Dubai. On in production; set 0 to disable, 1 to enable in dev.
REPORT_CRON=
REPORT_CRON_HOUR=6
REPORT_CRON_MINUTE=15
REPORT_STATE_DIR=
# Optional. Lets Coolify (or curl) trigger /api/cron/report with Authorization: Bearer …
CRON_SECRET=
